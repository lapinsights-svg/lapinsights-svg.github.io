---
layout: null
permalink: /articles.json
---
[
{% assign all = site.posts %}
{% for post in all %}
  {
    "slug": "{{ post.slug }}",
    "title": "{{ post.title | escape }}",
    "resume": "{{ post.resume | escape }}",
    "url": "{{ post.url }}"
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
