---
layout: null
---

[
{% assign all = site.actualites | concat: site.idees | concat: site.creations | concat: site.spiritualite | concat: site.passe %}
{% for post in all %}
  {
    "slug": "{{ post.slug }}",
    "title": "{{ post.title | escape }}",
    "resume": "{{ post.resume | escape }}",
    "url": "{{ post.url }}"
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
