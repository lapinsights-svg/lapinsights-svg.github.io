---
layout: null
permalink: /articles.json
---

[
{% assign all = "" | split: "" %}

{% for collection in site.collections %}
  {% assign all = all | concat: collection.docs %}
{% endfor %}

{% for post in all %}
  {
    "slug": "{{ post.slug | default: post.basename_without_ext }}",
    "title": {{ post.title | jsonify }},
    "resume": {{ post.resume | jsonify }},
    "url": {{ post.url | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
